{
  "rules": {
    "userPosts": {
      "$uid": {
        ".read": "auth !== null && ($uid === auth.uid || root.child('users').child($uid).child('prefs').child('visibility').val() !== 'private' || root.child('users').child($uid).child('friends').child(auth.uid).exists())",
        ".write": "$uid === auth.uid",
        "$pid": {
          ".validate": "newData.hasChildren(['type','items','ts']) && newData.child('type').isString() && (newData.child('type').val() === 'image' || newData.child('type').val() === 'video' || newData.child('type').val() === 'carousel')",
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth !== null",
        ".write": "$uid === auth.uid",
        "friends": {
          "$friendUid": {
            ".write": "auth !== null && ($uid === auth.uid || ($friendUid === auth.uid && (!newData.exists() || root.child('friendRequests').child(auth.uid).child($uid).exists())))"
          }
        },
        "groups": {
          "$gid": {
            ".write": "auth !== null && ($uid === auth.uid || root.child('groups').child($gid).child('admin').val() === auth.uid || root.child('groups').child($gid).child('mods').child(auth.uid).exists())"
          }
        },
        "email": {
          ".validate": false
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length < 6000000 && (newData.val().beginsWith('data:image/') || newData.val().beginsWith('https://firebasestorage.googleapis.com/') || newData.val().matches(/^https:\\/\\/lh[0-9]+\\.googleusercontent\\.com\\/.*/))"
        },
        "prefs": {
          "visibility": {
            ".validate": "newData.isString() && (newData.val() === 'public' || newData.val() === 'private')"
          },
          "whoMessage": {
            ".validate": "newData.isString() && (newData.val() === 'everyone' || newData.val() === 'friends')"
          },
          "lastSeen": {
            ".validate": "newData.isBoolean()"
          },
          "readReceipts": {
            ".validate": "newData.isBoolean()"
          },
          "typing": {
            ".validate": "newData.isBoolean()"
          },
          "hideEmail": {
            ".validate": "newData.isBoolean()"
          },
          "hidePhone": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "userData": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "chatPrefs": {
          "$key": {
            "pinned": {
              ".validate": "newData.isNumber()"
            },
            "archived": {
              ".validate": "newData.isNumber()"
            },
            "hiddenAt": {
              ".validate": "newData.isNumber()"
            },
            "muted": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "e2eBackup": {
          ".validate": "newData.hasChildren(['v','salt','iv','ct','iter','ts'])",
          "v": {
            ".validate": "newData.isNumber()"
          },
          "salt": {
            ".validate": "newData.isString() && newData.val().length < 100"
          },
          "iv": {
            ".validate": "newData.isString() && newData.val().length < 100"
          },
          "ct": {
            ".validate": "newData.isString() && newData.val().length < 60000"
          },
          "iter": {
            ".validate": "newData.isNumber() && newData.val() >= 100000 && newData.val() <= 2000000"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "usernames": {
      ".read": "auth !== null && query.orderByKey === true && query.limitToFirst <= 10 && query.startAt.length >= 1",
      "$username": {
        ".read": "auth !== null",
        ".write": "auth !== null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString()"
      }
    },
    "dmMsgs": {
      "$dmKey": {
        ".read": "auth !== null && $dmKey.contains(auth.uid)",
        ".write": "auth !== null && $dmKey.contains(auth.uid) && !newData.exists()",
        "$msgId": {
          ".write": "auth !== null && $dmKey.contains(auth.uid) && !root.child('blockedUsers').child($dmKey.replace(auth.uid, '').replace('_', '')).child(auth.uid).exists() && ((!data.exists() && newData.child('sender').val() === auth.uid) || (data.exists() && data.child('sender').val() === auth.uid))",
          ".validate": "newData.hasChildren(['sender','ts']) && (data.exists() ? newData.child('sender').val() === data.child('sender').val() : newData.child('sender').val() === auth.uid)",
          "status": {
            ".write": "auth !== null && $dmKey.contains(auth.uid) && !root.child('blockedUsers').child($dmKey.replace(auth.uid, '').replace('_', '')).child(auth.uid).exists() && data.parent().exists() && data.parent().child('sender').val() !== auth.uid",
            ".validate": "newData.isString() && (newData.val() === 'sent' || newData.val() === 'delivered' || newData.val() === 'read')"
          },
          "reactions": {
            "$emoji": {
              ".validate": "$emoji.length <= 16",
              "$rUid": {
                ".write": "auth !== null && $dmKey.contains(auth.uid) && !root.child('blockedUsers').child($dmKey.replace(auth.uid, '').replace('_', '')).child(auth.uid).exists() && $rUid === auth.uid",
                ".validate": "newData.val() === true"
              }
            }
          },
          "$f": {
            ".validate": "!newData.isString() || (($f === 'url' || $f === 'data') ? (newData.val().length < 9000000 && (newData.val().beginsWith('data:') || ($f === 'url' && newData.val().beginsWith('https://firebasestorage.googleapis.com/')))) : newData.val().length < 5000)",
            "$g": {
              ".validate": "!newData.isString() || newData.val().length < 12000000",
              "$h": {
                ".validate": "!newData.isString() || newData.val().length < 12000000"
              }
            }
          }
        }
      }
    },
    "groups": {
      "$gid": {
        ".read": "auth !== null && (data.child('members').child(auth.uid).exists() || data.child('admin').val() === auth.uid)",
        ".write": "auth !== null && ((!data.exists() && newData.child('admin').val() === auth.uid) || data.child('admin').val() === auth.uid)",
        "members": {
          "$uid": {
            ".write": "auth !== null && (root.child('groups').child($gid).child('admin').val() === auth.uid || (root.child('groups').child($gid).child('mods').child(auth.uid).exists() && $uid !== root.child('groups').child($gid).child('admin').val()) || ($uid === auth.uid && !newData.exists()) || ($uid === auth.uid && root.child('groups').child($gid).child('inviteActive').val() === true && newData.val() === root.child('groups').child($gid).child('inviteCode').val()) || ($uid === auth.uid && newData.val() === true && root.child('groups').child($gid).child('privacy').val() === 'public'))"
          }
        },
        "pending": {
          "$uid": {
            ".write": "auth !== null && (root.child('groups').child($gid).child('admin').val() === auth.uid || root.child('groups').child($gid).child('mods').child(auth.uid).exists() || ($uid === auth.uid && (!newData.exists() || (newData.val() === true && root.child('groups').child($gid).exists()))))"
          }
        },
        "mods": {
          "$uid": {
            ".write": "auth !== null && (root.child('groups').child($gid).child('admin').val() === auth.uid || ((root.child('groups').child($gid).child('mods').child(auth.uid).exists() || $uid === auth.uid) && !newData.exists()))"
          }
        },
        "privacy": {
          ".validate": "newData.val() === 'public' || newData.val() === 'private'"
        },
        "name": {
          ".write": "auth !== null && (root.child('groups').child($gid).child('admin').val() === auth.uid || root.child('groups').child($gid).child('mods').child(auth.uid).exists())"
        },
        "photo": {
          ".write": "auth !== null && (root.child('groups').child($gid).child('admin').val() === auth.uid || root.child('groups').child($gid).child('mods').child(auth.uid).exists())",
          ".validate": "newData.isString() && newData.val().length < 600000 && newData.val().beginsWith('data:image/')"
        },
        "description": {
          ".write": "auth !== null && (root.child('groups').child($gid).child('admin').val() === auth.uid || root.child('groups').child($gid).child('mods').child(auth.uid).exists())"
        }
      }
    },
    "groupMsgs": {
      "$gid": {
        ".read": "auth !== null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        ".write": "auth !== null && root.child('groups').child($gid).child('admin').val() === auth.uid && !newData.exists()",
        "$msgId": {
          ".write": "auth !== null && root.child('groups').child($gid).child('members').child(auth.uid).exists() && ((!data.exists() && newData.child('sender').val() === auth.uid) || (data.exists() && data.child('sender').val() === auth.uid))",
          ".validate": "newData.hasChildren(['sender','ts']) && (data.exists() ? newData.child('sender').val() === data.child('sender').val() : newData.child('sender').val() === auth.uid)",
          "reactions": {
            "$emoji": {
              ".validate": "$emoji.length <= 16",
              "$rUid": {
                ".write": "auth !== null && root.child('groups').child($gid).child('members').child(auth.uid).exists() && $rUid === auth.uid",
                ".validate": "newData.val() === true"
              }
            }
          },
          "$f": {
            ".validate": "!newData.isString() || (($f === 'url' || $f === 'data') ? (newData.val().length < 9000000 && (newData.val().beginsWith('data:') || ($f === 'url' && newData.val().beginsWith('https://firebasestorage.googleapis.com/')))) : newData.val().length < 5000)",
            "$g": {
              ".validate": "!newData.isString() || newData.val().length < 12000000",
              "$h": {
                ".validate": "!newData.isString() || newData.val().length < 12000000"
              }
            }
          }
        }
      }
    },
    "groupPolls": {
      "$gid": {
        ".read": "auth !== null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        ".write": "auth !== null && root.child('groups').child($gid).child('members').child(auth.uid).exists()"
      }
    },
    "pinnedMsgs": {
      "$pinKey": {
        ".read": "auth !== null && (($pinKey.beginsWith('dmMsgs_') && $pinKey.contains(auth.uid)) || ($pinKey.beginsWith('groupMsgs_') && root.child('groups').child($pinKey.replace('groupMsgs_', '')).child('members').child(auth.uid).exists()))",
        ".write": "auth !== null && (($pinKey.beginsWith('dmMsgs_') && $pinKey.contains(auth.uid)) || ($pinKey.beginsWith('groupMsgs_') && root.child('groups').child($pinKey.replace('groupMsgs_', '')).child('members').child(auth.uid).exists()))"
      }
    },
    "inviteCodes": {
      "$code": {
        ".read": "auth !== null",
        ".write": "auth !== null && ((newData.exists() && newData.isString() && root.child('groups').child(newData.val()).child('admin').val() === auth.uid) || (!newData.exists() && data.exists() && root.child('groups').child(data.val()).child('admin').val() === auth.uid))"
      }
    },
    "presence": {
      ".read": "auth !== null",
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "friendRequests": {
      "$targetUid": {
        ".read": "$targetUid === auth.uid",
        ".write": "$targetUid === auth.uid && !newData.exists()",
        "$senderUid": {
          ".read": "auth !== null && ($senderUid === auth.uid || $targetUid === auth.uid)",
          ".write": "auth !== null && (($targetUid === auth.uid && !newData.exists()) || ($senderUid === auth.uid && $targetUid !== auth.uid && (!newData.exists() || (newData.child('from').val() === auth.uid && !root.child('blockedUsers').child($targetUid).child(auth.uid).exists()))))"
        }
      }
    },
    "blockedUsers": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$other": {
          ".read": "auth !== null && ($uid === auth.uid || $other === auth.uid)",
          ".write": "$uid === auth.uid"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$nid": {
          ".write": "auth !== null && ($uid === auth.uid || (!data.exists() && ((newData.child('type').val() === 'friend_request' && newData.child('fromUid').val() === auth.uid && root.child('friendRequests').child($uid).child(auth.uid).exists()) || (newData.child('type').val() === 'friend_accept' && newData.child('fromUid').val() === auth.uid && root.child('users').child(auth.uid).child('friends').child($uid).exists()) || (newData.child('type').val() === 'group_add' && newData.child('byUid').val() === auth.uid && newData.child('gid').isString() && root.child('groups').child(newData.child('gid').val()).child('members').child($uid).exists() && (root.child('groups').child(newData.child('gid').val()).child('admin').val() === auth.uid || root.child('groups').child(newData.child('gid').val()).child('mods').child(auth.uid).exists())))))",
          ".validate": "newData.hasChildren(['type','ts']) && newData.child('type').val() !== null && (newData.child('type').val() === 'friend_request' || newData.child('type').val() === 'friend_accept' || newData.child('type').val() === 'group_add')",
          "$f": {
            ".validate": "!newData.isString() || newData.val().length < 500"
          }
        }
      }
    },
    "reports": {
      "$rid": {
        ".write": "auth !== null && !data.exists() && newData.child('reporterUid').val() === auth.uid"
      }
    },
    "readReceipts": {
      "$chatKey": {
        ".read": "auth !== null && ($chatKey.contains(auth.uid) || ($chatKey.beginsWith('group_') && root.child('groups').child($chatKey.replace('group_', '')).child('members').child(auth.uid).exists()))",
        "$uid": {
          ".write": "$uid === auth.uid"
        }
      }
    },
    "typing": {
      "$type": {
        "$chat": {
          ".read": "auth !== null && (($type === 'dm' && $chat.contains(auth.uid)) || ($type === 'group' && root.child('groups').child($chat).child('members').child(auth.uid).exists()))",
          ".write": "auth !== null && $type === 'group' && root.child('groups').child($chat).child('admin').val() === auth.uid && !newData.exists()",
          "$name": {
            ".write": "auth !== null && root.child('usernames').child($name).val() === auth.uid && (($type === 'dm' && $chat.contains(auth.uid)) || ($type === 'group' && root.child('groups').child($chat).child('members').child(auth.uid).exists()))",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "stories": {
      "$uid": {
        ".write": "$uid === auth.uid",
        "$sid": {
          "url": {
            ".validate": "newData.isString() && newData.val().length < 9000000 && (newData.val().beginsWith('data:') || newData.val().beginsWith('https://firebasestorage.googleapis.com/'))"
          }
        },
        ".read": "auth !== null && ($uid === auth.uid || root.child('users').child($uid).child('friends').child(auth.uid).exists())"
      }
    },
    "storyViews": {
      "$owner": {
        ".read": "$owner === auth.uid",
        "$sid": {
          ".write": "$owner === auth.uid",
          "$viewer": {
            ".write": "$viewer === auth.uid"
          }
        }
      }
    },
    "userKeys": {
      "$uid": {
        ".read": "auth !== null",
        ".write": "auth !== null && $uid === auth.uid",
        ".validate": "newData.hasChildren(['pub','kid','v','ts'])",
        "pub": {
          ".validate": "newData.isString() && newData.val().length > 20 && newData.val().length < 400"
        },
        "kid": {
          ".validate": "newData.isString() && newData.val().length === 32"
        },
        "v": {
          ".validate": "newData.isNumber()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userDevices": {
      "$uid": {
        ".read": "auth !== null",
        "$dev": {
          ".write": "auth !== null && $uid === auth.uid",
          ".validate": "$dev.length >= 8 && $dev.length <= 32 && newData.hasChildren(['pub','kid','v','ts'])",
          "pub": {
            ".validate": "newData.isString() && newData.val().length > 20 && newData.val().length < 400"
          },
          "kid": {
            ".validate": "newData.isString() && newData.val().length === 32"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        ".write": "auth !== null && $uid === auth.uid && !newData.exists()"
      }
    }
  }
}
